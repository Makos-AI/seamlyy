generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ARTIST
  VIEWER
}

enum ArtworkStatus {
  NOT_FOR_SALE
  FIXED_PRICE
  SOLD
}

enum TransactionType {
  ONE_TIME_PURCHASE
  PAY_TO_VIEW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id              String    @id @default(uuid())
  role            UserRole  @default(VIEWER)
  email           String    @unique
  emailVerified   DateTime?
  hashedPassword  String?
  googleId        String?   @unique
  walletPointer   String?   @unique
  name            String?
  image           String?
  bio             String?
  location        String?
  socialLinks     Json?

  artworks        Artwork[]
  galleries       Gallery[]
  purchases       Transaction[]  @relation("Buyer")
  sales           Transaction[]  @relation("Seller")
  galleryAccess   GalleryAccess[]
  savedArtworks   SavedArtwork[]
  followers       Follow[]       @relation("Following")
  following       Follow[]       @relation("Follower")
  accounts        Account[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Gallery {
  id              String    @id @default(uuid())
  artistId        String
  title           String
  description     String?
  accessFee       Decimal   @db.Decimal(10, 2)
  coverImageUrl   String
  coverImageKey   String

  artist          User      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artworks        Artwork[]
  transactions    Transaction[]
  access          GalleryAccess[]

  createdAt       DateTime  @default(now())

  @@index([artistId])
  @@map("galleries")
}

model Artwork {
  id              String        @id @default(uuid())
  artistId        String
  galleryId       String?
  title           String
  description     String?
  medium          String?
  dimensions      String?
  yearCreated     Int?
  category        String?
  status          ArtworkStatus @default(NOT_FOR_SALE)
  price           Decimal?      @db.Decimal(10, 2)
  thumbnailUrl    String
  thumbnailKey    String
  highResKey      String

  artist          User          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  gallery         Gallery?      @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  savedBy         SavedArtwork[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([artistId])
  @@index([galleryId])
  @@index([status])
  @@index([category])
  @@map("artworks")
}

model Transaction {
  id                    String            @id @default(uuid())
  buyerId               String
  sellerId              String
  artworkId             String?
  galleryId             String?
  type                  TransactionType
  amount                Decimal           @db.Decimal(10, 2)
  platformFee           Decimal           @db.Decimal(10, 2) @default(0)
  currency              String            @default("USD")
  openPaymentsUrl       String?
  status                TransactionStatus @default(PENDING)
  shippingDetails       Json?

  buyer                 User              @relation("Buyer", fields: [buyerId], references: [id])
  seller                User              @relation("Seller", fields: [sellerId], references: [id])
  artwork               Artwork?          @relation(fields: [artworkId], references: [id])
  gallery               Gallery?          @relation(fields: [galleryId], references: [id])
  galleryAccess         GalleryAccess[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@map("transactions")
}

model GalleryAccess {
  viewerId        String
  galleryId       String
  transactionId   String

  viewer          User          @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  gallery         Gallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  transaction     Transaction   @relation(fields: [transactionId], references: [id])

  unlockedAt      DateTime      @default(now())

  @@id([viewerId, galleryId])
  @@map("gallery_access")
}

model SavedArtwork {
  viewerId    String
  artworkId   String
  viewer      User      @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  artwork     Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  savedAt     DateTime  @default(now())

  @@id([viewerId, artworkId])
  @@map("saved_artworks")
}

model Follow {
  followerId    String
  followingId   String
  follower      User    @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following     User    @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([followerId, followingId])
  @@map("follows")
}
